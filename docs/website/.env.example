# Production docs (Sevalla): set at build time on the app that serves https://docs.qvac.tether.io
# so static HTML declares index,follow. Omit on preview/staging/PR builds.
# DOCS_ALLOW_INDEXING=true

# How many workers the build runs, as `value - 1`. Set it on every builder that
# runs `next build` (Sevalla: Environment variables), because one worker per
# core — the default — makes static generation outgrow the builder's memory and
# the build is killed with no progress past `Generating static pages (0/N)`.
# Each worker carries the Open Graph image renderer, so memory is per worker
# while time is per page: two workers cost seconds and several gigabytes less.
# The name is Next's own: it reads CircleCI's variable before counting cores.
CIRCLE_NODE_TOTAL=3

# Inkeep API Key for search and chat functionality
NEXT_PUBLIC_INKEEP_API_KEY=your_inkeep_api_key_here

# Path to the sdk package (used by scripts/generate-api-docs.ts).
# Example (Windows): SDK_PATH=D:\QVAC\qvac\packages\sdk
# Example (Unix):    SDK_PATH=/path/to/qvac/packages/sdk
SDK_PATH=
